<script>
    /* ---- Dynamický měsíc a rok v title stránky a v nadpisu sekce kupónů ---- */
    (function(){
        var czMonths = ['leden','únor','březen','duben','květen','červen','červenec','srpen','září','říjen','listopad','prosinec'];
        var now = new Date();
        var monthYear = czMonths[now.getMonth()] + ' ' + now.getFullYear();
        document.title = 'Kupóny a slevy ' + monthYear + ' aktuální';
        var h2 = document.getElementById('couponsSectionTitle');
        if (h2) h2.textContent = 'Aktuální slevové kupóny ' + monthYear;
    })();

    /* ---- Vlastní (nezávislý) ovládač kupón-popupu, funguje bez Vue/Bootstrap JS ---- */
    function openCouponModal(){
        var modal = document.getElementById('msgModalNewsletter');
        var backdrop = document.createElement('div');
        backdrop.className = 'coupon-modal-backdrop';
        backdrop.id = 'couponModalBackdrop';
        backdrop.onclick = closeCouponModal;
        document.body.appendChild(backdrop);
        modal.style.display = 'block';
        document.body.classList.add('modal-open');
    }
    function closeCouponModal(){
        var modal = document.getElementById('msgModalNewsletter');
        var backdrop = document.getElementById('couponModalBackdrop');
        modal.style.display = 'none';
        if (backdrop) backdrop.remove();
        document.body.classList.remove('modal-open');
    }
    function submitCouponNewsletter(e){
        e.preventDefault();
        var email = document.querySelector('#couponNewsletterForm input[name="email"]').value;
        document.getElementById('newsletterMessageBody').innerHTML =
            '<p style="padding:30px 0;text-align:center;font-size:15px;">Děkujeme! Kupón na slevu <strong>350 Kč</strong> jsme odeslali na e-mail<br><strong>' + email + '</strong>.</p>';
        return false;
    }
</script>
